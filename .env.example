# Environment Configuration for Soufi POS
APP_ENV="dev" # "dev" | "prod" | "test"
PROJECT_NAME="Soufi Restaurant POS Backend"
API_V1_STR="/api"
SECRET_KEY="soufi-pos-super-secret-key-change-in-production-12345"
DATABASE_URL="sqlite:///./pos.db"

# Restaurant Operating Hours & Boundaries
OPENING_TIME="07:00"
CLOSING_TIME="23:00"
BUSINESS_DAY_START_HOUR=5

# Default Tax Rate (0.0% per specs)
TAX_RATE=0.0
SERVICE_CHARGE_RATE=0.0
CURRENCY_SYMBOL="Rs"
TIMEZONE="Asia/Karachi"

# Printing Settings (Phase B4)
PRINT_MODE="simulate" # "simulate" | "network"
PRINT_COLUMNS=48 # Valid: 32, 42, 48
PRINT_CONNECT_TIMEOUT=2.0
PRINT_SEND_TIMEOUT=4.0
PRINT_CHECK_STATUS=true
PRINT_CUT=true
PRINT_CASH_DRAWER_KICK=false # pulse drawer on cash payments
PRINT_RECOVER_MAX_AGE_MINUTES=10
PRINT_JOB_RETENTION_DAYS=60
PRINT_SIM_DIR="data/print_sim"
SIMULATE_FAIL_PRINTERS="" # e.g. "p1,p2"

# Image Uploads
UPLOAD_DIR="backend/uploads"
PUBLIC_BASE_URL="" # e.g. "http://192.168.1.50:8000" (leave empty for automatic request host)

# WebSocket Real-Time Gateway (Phase B6)
WS_HEARTBEAT_SECONDS=20
WS_IDLE_TIMEOUT_SECONDS=60
WS_MAX_CONNECTIONS=50
WS_SEND_QUEUE_MAX=100
WS_COALESCE_MS=50
WS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
WS_MAX_MESSAGE_BYTES=4096

# Database Durability, Backups & Maintenance (Phase B7)
SQLITE_SYNCHRONOUS="FULL" # "FULL" in production | "NORMAL" in dev/tests
BACKUP_DIR="data/backups"
BACKUP_TIME="03:00"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_EXTRA_DIR="" # e.g. "/mnt/media_rw/usb_drive" or external path
BACKUP_COMMAND="" # optional post-backup script
BACKUP_MIN_FREE_MB=500
AUDIT_RETENTION_DAYS=730

# Server Launcher, TLS & Packaging (Phase B8)
SERVER_MODE="plain" # "plain" | "https"
BIND_HOST="0.0.0.0"
HTTP_PORT=8000
HTTPS_PORT=8443
HELPER_HTTP_PORT=8080
TLS_CERT_FILE="certs/server.crt"
TLS_KEY_FILE="certs/server.key"
TLS_CA_CERT_FILE="certs/ca.crt"
TLS_CA_KEY_FILE="certs/ca.key"
FRONTEND_DIST_DIR="" # path to static frontend build if served directly (e.g. "frontend/out")
KEEPALIVE_TIMEOUT=65

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
NEXT_PUBLIC_USE_MOCK="false"
NEXT_PUBLIC_ENABLE_DEV_TOOLS="false"
NEXT_PUBLIC_WS_ENABLED="true"

